# PC Inventory Manager server configuration (systemd EnvironmentFile).
# Edit, then: sudo systemctl restart pcim-server
#
# 127.0.0.1 = this computer only. Uncomment the next line to accept agents
# from other computers on your private network:
#PCIM_LISTEN_HOST=0.0.0.0
#PCIM_PORT=8080
#PCIM_TLS_SELF_SIGNED=true
#PCIM_RETENTION_DAYS=30
#PCIM_OFFLINE_THRESHOLD_SEC=90
