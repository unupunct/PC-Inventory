# PC Inventory Manager server configuration (Windows service).
# Edit, then restart the service:  Restart-Service pcim-server
#
# 127.0.0.1 = this computer only, 0.0.0.0 = accept agents on the LAN.
PCIM_LISTEN_HOST=0.0.0.0
PCIM_PORT=8080
#PCIM_TLS_SELF_SIGNED=true
#PCIM_RETENTION_DAYS=30
#PCIM_OFFLINE_THRESHOLD_SEC=90
